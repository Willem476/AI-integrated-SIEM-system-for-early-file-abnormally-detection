digraph dfir_pipeline {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, bgcolor="white", pad=0.4, nodesep=0.45, ranksep=0.55, splines=spline,
         label="DFIR Pipeline - Phishing-to-C2 Detection and Automated Evidence Collection", labelloc=t, fontsize=18];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#555555", fillcolor="#FFFFFF", margin="0.18,0.10"];
  edge  [fontname="Helvetica", fontsize=9, color="#444444", arrowsize=0.8];

  subgraph cluster_attack {
    label="1. Attack stage"; style="rounded,filled"; fillcolor="#FDECEC"; color="#D9534F"; fontsize=13;
    kali    [label="Kali / Mythic C2 server\n192.168.1.7\nHTTP listener :443", fillcolor="#F8D7DA"];
    phish   [label="Phishing email\nwith malicious attachment"];
    victim  [label="Windows VM (victim)\n10.10.12.20\nAttachment executed -> C2 agent\n(Sysmon: T1036 Masquerading)", fillcolor="#F8D7DA"];
  }

  subgraph cluster_detect {
    label="2. Network detection"; style="rounded,filled"; fillcolor="#EAF2FB"; color="#337AB7"; fontsize=13;
    pfsense  [label="pfSense firewall\nLAN 10.10.12.2"];
    suricata [label="Suricata IDS (LAN interface)\npre-NAT endpoint IP preserved", fillcolor="#D6E6F7"];
    eve      [label="eve.json\n(EVE JSON alerts)", shape=note, fillcolor="#FFFFFF"];
  }

  subgraph cluster_siem {
    label="3. SIEM ingestion"; style="rounded,filled"; fillcolor="#EAF7EA"; color="#5CB85C"; fontsize=13;
    shipper [label="Shell script on pfSense\ncurl POST -> Bulk API\n(Filebeat unsupported on FreeBSD)"];
    es      [label="Elasticsearch\nUbuntu VM 10.10.12.11", fillcolor="#D4EDDA"];
    kibana  [label="Kibana / Elastic SIEM\nalert triage", fillcolor="#D4EDDA"];
  }

  subgraph cluster_soar {
    label="4. Automated response (trigger script)"; style="rounded,filled"; fillcolor="#FFF6E5"; color="#F0AD4E"; fontsize=13;
    trigger [label="Trigger script\nfires on new Suricata alert", fillcolor="#FFE8B3"];
    tcpdump [label="tcpdump on pfSense\n(alert-triggered capture)"];
    velo    [label="Velociraptor server\n10.10.12.22\ncollection on Windows client"];
  }

  subgraph cluster_evidence {
    label="5. Evidence set (per incident)"; style="rounded,filled"; fillcolor="#F3EEF9"; color="#8E6BBF"; fontsize=13;
    ev_alert [label="alert.json",      shape=note];
    ev_pcap  [label="traffic.pcap",    shape=note];
    ev_mem   [label="memory.dmp",      shape=note];
    ev_file  [label="suspicious_file", shape=note];
  }

  subgraph cluster_analysis {
    label="6. Forensic analysis"; style="rounded,filled"; fillcolor="#F2F2F2"; color="#777777"; fontsize=13;
    wireshark  [label="Wireshark\nnetwork / C2 traffic"];
    volatility [label="Volatility\nprocess, injection, network artifacts"];
    static     [label="Static file analysis\nhashes, strings, PE, threat intel"];
    report     [label="Incident report\ntimeline + MITRE ATT&CK mapping", fillcolor="#E0E0E0"];
  }

  kali   -> phish   [label=" deliver"];
  phish  -> victim  [label=" user opens"];
  victim -> pfsense [label=" C2 beacon HTTPS :443", color="#D9534F", fontcolor="#D9534F"];
  pfsense -> kali   [label=" NAT via WAN 192.168.166.131", style=dashed, color="#D9534F", fontcolor="#D9534F", constraint=false];
  pfsense -> suricata [label=" inspect LAN traffic"];
  suricata -> eve     [label=" alert"];

  eve     -> shipper;
  shipper -> es      [label=" index"];
  es      -> kibana;

  eve     -> trigger [label=" new alert", color="#F0AD4E", fontcolor="#B8860B"];
  trigger -> tcpdump [label=" start capture"];
  trigger -> velo    [label=" start collection"];
  velo    -> victim  [label=" RAM dump + file acquisition", style=dashed, constraint=false];

  trigger -> ev_alert [label=" export alert"];
  tcpdump -> ev_pcap;
  velo    -> ev_mem;
  velo    -> ev_file;

  ev_pcap  -> wireshark;
  ev_mem   -> volatility;
  ev_file  -> static;
  ev_alert -> report [label=" context"];
  wireshark -> report;
  volatility -> report;
  static -> report;
  kibana -> report [label=" correlate endpoint telemetry", style=dashed, constraint=false];
}
